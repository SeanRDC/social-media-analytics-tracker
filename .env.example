# Copy to .env.local for local development. On Vercel, add these in
# Project Settings → Environment Variables. Never commit real values.

# --- Database ---------------------------------------------------------------
# Neon pooled connection string. Leave unset locally to use the embedded
# PGlite database in .data/pglite (no setup needed).
DATABASE_URL=

# --- App sign-in (Better Auth) ----------------------------------------------
# Required in production. Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://your-app.vercel.app (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# --- Email for sign-in links (Resend) ----------------------------------------
# Optional locally: without it, links are printed in the server log and shown on
# the "check your email" screen in development. Required in production.
RESEND_API_KEY=
EMAIL_FROM="Social Tracker <signin@your-domain.com>"

# --- Optional social sign-in (buttons appear only when both values are set) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Platform connections (phase 2) ------------------------------------------
# Encrypts platform tokens at rest (AES-256-GCM). Required in production.
# Generate with: openssl rand -base64 32. Changing it means everyone reconnects.
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron/daily (token refresh + daily sync).
CRON_SECRET=
# Outside production, platforms without credentials are simulated so the flow
# works locally. Set to "off" to hide them instead.
CONNECT_SIMULATION=

# Redirect URI for each platform: <BETTER_AUTH_URL>/api/connect/<platform>/callback
# YouTube reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
META_APP_ID=
META_APP_SECRET=
# Optional: Graph API version for Facebook (default v26.0)
META_GRAPH_VERSION=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: LinkedIn API version, YYYYMM (default 202607; LinkedIn retires old ones)
LINKEDIN_API_VERSION=

# --- Legal pages --------------------------------------------------------------
# Shown on /privacy, /terms and /data-deletion. Set before any platform review.
LEGAL_CONTACT_EMAIL=

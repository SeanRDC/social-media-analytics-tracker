# Copy to .env.local for local development. On Vercel, add these in
# Project Settings → Environment Variables. Never commit real values.

# --- Database ---------------------------------------------------------------
# Neon pooled connection string. Leave unset locally to use the embedded
# PGlite database in .data/pglite (no setup needed).
DATABASE_URL=

# --- App sign-in (Better Auth) ----------------------------------------------
# Required in production. Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://your-app.vercel.app (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# --- Email for sign-in links (Resend) ----------------------------------------
# Optional locally: without it, links are printed in the server log and shown on
# the "check your email" screen in development. Required in production.
RESEND_API_KEY=
EMAIL_FROM="Social Tracker <signin@your-domain.com>"

# --- Optional social sign-in (buttons appear only when both values are set) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Legal pages --------------------------------------------------------------
# Shown on /privacy, /terms and /data-deletion. Set before any platform review.
LEGAL_CONTACT_EMAIL=
